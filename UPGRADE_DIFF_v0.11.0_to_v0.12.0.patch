diff -ruN -x FINAL_RELEASE_GATE_v0.12.0.txt -x '*.patch' v11/app/src/test/java/com/siteguard/app/core/HygieneParsersTest.kt v12/app/src/test/java/com/siteguard/app/core/HygieneParsersTest.kt
--- v11/app/src/test/java/com/siteguard/app/core/HygieneParsersTest.kt	1970-01-01 00:00:00.000000000 +0000
+++ v12/app/src/test/java/com/siteguard/app/core/HygieneParsersTest.kt	2026-11-23 05:29:00.779839829 +0000
@@ -0,0 +1,79 @@
+package com.siteguard.app.core
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class HygieneParsersTest {
+    private val now = java.time.OffsetDateTime.parse("2026-11-23T00:00:00Z").toInstant().toEpochMilli()
+    private fun ids(list: List<Finding>) = list.map { it.id }
+
+    @Test fun securityTxtFieldsAreParsed() {
+        val info = SecurityTxtV1.parse(
+            """
+            # comment
+            Contact: mailto:security@example.com
+            Contact: https://example.com/report
+            Contact: bogus-value
+            Expires: 2027-01-01T00:00:00Z
+            Policy: https://example.com/policy
+            Encryption: https://example.com/pgp.txt
+            Canonical: https://example.com/.well-known/security.txt
+            """.trimIndent()
+        )
+        assertEquals(3, info.contacts.size)
+        assertEquals(2, info.validContacts.size)
+        assertNotNull(info.expiresEpochMs)
+        assertTrue(info.hasPolicy && info.hasEncryption)
+        assertFalse(info.signed)
+        assertTrue(SecurityTxtV1.evaluate("example.com", 200, info, now).isEmpty())
+    }
+
+    @Test fun securityTxtProblemsAreFlagged() {
+        val noContact = SecurityTxtV1.parse("Expires: 2027-01-01T00:00:00Z")
+        assertTrue("SG-SECTXT-NO-CONTACT" in ids(SecurityTxtV1.evaluate("example.com", 200, noContact, now)))
+        val noExpires = SecurityTxtV1.parse("Contact: mailto:a@example.com")
+        assertTrue("SG-SECTXT-NO-EXPIRES" in ids(SecurityTxtV1.evaluate("example.com", 200, noExpires, now)))
+        val bad = SecurityTxtV1.parse("Contact: mailto:a@example.com\nExpires: next year")
+        assertTrue("SG-SECTXT-BAD-EXPIRES" in ids(SecurityTxtV1.evaluate("example.com", 200, bad, now)))
+        val expired = SecurityTxtV1.parse("Contact: mailto:a@example.com\nExpires: 2025-01-01T00:00:00Z")
+        assertTrue("SG-SECTXT-EXPIRED" in ids(SecurityTxtV1.evaluate("example.com", 200, expired, now)))
+    }
+
+    @Test fun securityTxtMissingOnlyOn404Or410() {
+        assertEquals(listOf("SG-SECTXT-MISSING"), ids(SecurityTxtV1.evaluate("example.com", 404, null, now)))
+        assertEquals(listOf("SG-SECTXT-MISSING"), ids(SecurityTxtV1.evaluate("example.com", 410, null, now)))
+        assertTrue(SecurityTxtV1.evaluate("example.com", 403, null, now).isEmpty())
+        assertTrue(SecurityTxtV1.evaluate("example.com", 500, null, now).isEmpty())
+    }
+
+    @Test fun securityTxtFindingsAreNeverConfirmed() {
+        val all = SecurityTxtV1.evaluate("example.com", 200, SecurityTxtV1.parse("Policy: x"), now) + SecurityTxtV1.evaluate("example.com", 404, null, now)
+        assertTrue(all.isNotEmpty() && all.none { it.status == FindingStatus.CONFIRMED })
+    }
+
+    @Test fun hstsParsing() {
+        val h = HstsPolicyV1.parse("max-age=31536000; includeSubDomains; preload")
+        assertEquals(31_536_000L, h.maxAgeSeconds)
+        assertTrue(h.includeSubDomains && h.preload)
+        assertEquals(63_072_000L, HstsPolicyV1.parse("Max-Age=\"63072000\"").maxAgeSeconds)
+        assertNull(HstsPolicyV1.parse("includeSubDomains").maxAgeSeconds)
+        assertNull(HstsPolicyV1.parse("max-age=abc").maxAgeSeconds)
+        assertNull(HstsPolicyV1.parse("max-age=-5").maxAgeSeconds)
+    }
+
+    @Test fun hstsEvaluation() {
+        fun ev(v: String) = ids(HstsPolicyV1.evaluate("example.com", HstsPolicyV1.parse(v)))
+        assertTrue(ev("max-age=31536000; includeSubDomains").isEmpty())
+        assertTrue(ev("max-age=15552000").isEmpty())
+        assertEquals(listOf("SG-HSTS-SHORT"), ev("max-age=86400"))
+        assertEquals(listOf("SG-HSTS-DISABLED"), ev("max-age=0"))
+        assertEquals(listOf("SG-HSTS-INVALID"), ev("includeSubDomains"))
+        assertTrue("SG-HSTS-PRELOAD-INELIGIBLE" in ev("max-age=31536000; preload"))
+        assertTrue("SG-HSTS-PRELOAD-INELIGIBLE" in ev("max-age=15552000; includeSubDomains; preload"))
+        assertFalse("SG-HSTS-PRELOAD-INELIGIBLE" in ev("max-age=63072000; includeSubDomains; preload"))
+    }
+}
