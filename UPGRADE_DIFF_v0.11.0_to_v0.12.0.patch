diff -ruN -x FINAL_RELEASE_GATE_v0.12.0.txt -x '*.patch' v11/app/src/main/java/com/siteguard/app/core/HygieneParsersV1.kt v12/app/src/main/java/com/siteguard/app/core/HygieneParsersV1.kt
